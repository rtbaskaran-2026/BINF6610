# The same recipe as the Dockerfile beside this file, in Apptainer's syntax.
Bootstrap: docker
From: mambaorg/micromamba:2.0.5-ubuntu24.04

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    micromamba install -y -n base \
        -c conda-forge -c bioconda --override-channels \
        bwa=0.7.19 \
        samtools=1.24 \
        bcftools=1.24 \
        gatk4=4.6.2.0 \
        fastqc=0.12.1 \
        fastp=1.3.7 \
        multiqc=1.35 \
        git=2.47.1
    micromamba clean --all --yes

%environment
    export PATH=/opt/conda/bin:$PATH

%labels
    course BINF6610
